# Domein dat naar je Hetzner-server wijst (A-record), bv. joe.jouwdomein.nl
DOMAIN=joe.jouwdomein.nl

# Van https://developer.spotify.com/dashboard (je eigen app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Wachtwoord om de pagina te openen
APP_PASSWORD=

# Willekeurige lange string, bv. uitvoer van: openssl rand -hex 32
SECRET_KEY=

# Optioneel: andere bron(nen) voor de JOE-playlist (komma-gescheiden, {date} = JJJJ-MM-DD)
# JOE_API_URLS=https://api.joe.nl/2.0/tracks/plays?limit=500&_station_id=joe_nl
# JOE_PLAYLIST_URL=https://joe.nl/playlist
